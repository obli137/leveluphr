# Formularios de contacto (API en Vercel)
# Crear cuenta en https://resend.com y agregar estas variables en Vercel → Project → Settings → Environment Variables

RESEND_API_KEY=re_xxxxxxxxxxxx
# Opcional: para enviar desde tu dominio (ej. después de verificar hrlevel-up.com en Resend)
# FROM_EMAIL=LevelUp <noreply@hrlevel-up.com>

# Nota: En local, el API solo corre con "vercel dev". En producción (Vercel) funciona al hacer deploy.
